<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Disable Credential Manager for Google Sign-In -->
<meta-data
    android:name="com.google.android.gms.credentials.API_ENABLED"
    android:value="false" />

<meta-data
    android:name="com.google.android.gms.credentials.CredentialPickerConfig"
    android:value="false" />

<meta-data
    android:name="androidx.credentials.CREDENTIAL_SERVICE_ENABLED"
    android:value="false" />
</manifest>
